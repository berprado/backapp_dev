# Ejemplo de variables de entorno
# Copiar este archivo a .env y completar con los valores reales

# Credenciales SIAT
SIAT_API_KEY="TU_API_KEY_SIAT"
SIAT_NIT="TU_NIT"
SIAT_CODIGO_SISTEMA="TU_CODIGO_DE_SISTEMA"
SIAT_CODIGO_AMBIENTE="2" # 1 para PRODUCCION, 2 para PRUEBAS
SIAT_CODIGO_MODALIDAD="2" # 1 para ELECTRONICA_EN_LINEA, 2 para COMPUTARIZADA_EN_LINEA
SIAT_CODIGO_SUCURSAL="0" # 0 para Casa Matriz
SIAT_CODIGO_PUNTO_VENTA="0" # 0 por defecto, si no se tienen varios

# Configuración Base de Datos (ejemplo para SQLite)
# DATABASE_URL="sqlite:///./facturador_siat.db"

# Otras configuraciones
# LOG_LEVEL="INFO"
